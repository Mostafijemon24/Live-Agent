# Copy to .env and replace every placeholder. Never commit .env.
# Generate strong values with:  openssl rand -base64 32

# --- docker compose ---
POSTGRES_SUPERUSER_PASSWORD=replace-me
STEWARD_OWNER_PASSWORD=replace-me
STEWARD_APP_PASSWORD=replace-me
STEWARD_WORKER_PASSWORD=replace-me     # orchestrator, tools worker, scheduler (no DELETE, no secrets)
STEWARD_DELETER_PASSWORD=replace-me    # deletion service only
STEWARD_READONLY_PASSWORD=replace-me   # reporting/support (SELECT only, no secrets)
# Signs approval requests (HMAC); at least 32 random characters.
APPROVAL_SIGNING_KEY=replace-me
APP_ENV=development            # set to "production" on the VPS
APP_ORIGIN=http://localhost:3000  # production: https://your-domain.example
DOMAIN=localhost               # used by the optional Caddy TLS profile
WEB_BIND=127.0.0.1             # interface the web port binds to (keep 127.0.0.1 behind Caddy)
TRUST_PROXY_HEADERS=false      # set true only with `--profile tls` (Caddy sets X-Real-IP)

# --- AI model provider (server-side only; never entered in the browser) ---
# none               = no model: tasks are saved and wait; nothing is sent anywhere (default)
# openai_compatible  = any /v1/chat/completions endpoint: OpenAI, a gateway, or self-hosted Ollama/vLLM
# mock               = deterministic built-in planner for development/tests (refused in production)
MODEL_PROVIDER=none
MODEL_BASE_URL=                # e.g. https://api.openai.com/v1  or  http://ollama:11434/v1
MODEL_NAME=                    # e.g. gpt-4o-mini  or  llama3.1:8b
MODEL_API_KEY=                 # leave empty for local servers that need none
MODEL_LOCATION=external        # external = third-party service (data leaves your servers); local = you operate it
MODEL_PROVIDER_LABEL=          # shown to users, e.g. "OpenAI (US)" or "Ollama on this server"
MONTHLY_MODEL_TOKEN_QUOTA=2000000
SANDBOX_ENABLED=true           # code steps run only if the tools worker can create an isolated sandbox
DELETION_RETENTION_DAYS=30     # deleted files are restorable for this long, then purged

# --- mail ---
MAIL_BACKEND=outbox            # outbox (development only) | smtp | disabled
MAIL_FROM=Steward <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- running the API outside Docker (api/.env) ---
# DATABASE_URL=postgresql+psycopg://steward_app:<password>@127.0.0.1:5432/steward
# MIGRATION_DATABASE_URL=postgresql+psycopg://steward_owner:<password>@127.0.0.1:5432/steward
# STORAGE_DIR=./var/storage
# MAIL_OUTBOX_DIR=./var/mail-outbox
# RATE_LIMIT_ENABLED=true
# MAX_UPLOAD_BYTES=26214400
# WORKSPACE_STORAGE_QUOTA_BYTES=1073741824
# MONTHLY_TASK_QUOTA=500
# WORKER_DATABASE_URL=postgresql+psycopg://steward_worker:<password>@127.0.0.1:5432/steward
# DELETION_DATABASE_URL=postgresql+psycopg://steward_deleter:<password>@127.0.0.1:5432/steward
# Development only (never in production): let tools reach a local test site
# EGRESS_ALLOW_PRIVATE_NETWORKS=false
# EGRESS_ALLOW_HTTP=false

# --- web (build time) ---
# API_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_DEMO_MODE=false   # true = in-browser sample data only, no backend calls
